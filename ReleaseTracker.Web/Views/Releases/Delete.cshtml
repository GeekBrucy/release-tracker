@model ReleaseTracker.Web.Models.Release

@{
    ViewData["Title"] = "Delete Release";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2 class="text-danger">Delete Release</h2>
            <hr />

            <div class="alert alert-danger">
                <h5>Are you sure you want to delete this release?</h5>
                <p><strong>Warning:</strong> This action cannot be undone. All release information will be permanently deleted.</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Release Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Application</dt>
                        <dd class="col-sm-8">@Model.App?.Name</dd>

                        <dt class="col-sm-4">Version</dt>
                        <dd class="col-sm-8">@Model.Version</dd>

                        <dt class="col-sm-4">Environment</dt>
                        <dd class="col-sm-8">@Model.Environment</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>

                        <dt class="col-sm-4">Release Date</dt>
                        <dd class="col-sm-8">@Model.ReleaseDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Released By</dt>
                        <dd class="col-sm-8">@Model.ReleasedBy</dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <dt class="col-sm-4">Description</dt>
                            <dd class="col-sm-8">@Model.Description</dd>
                        }
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>
