@model IEnumerable<ReleaseTracker.Web.Models.Release>

@{
    ViewData["Title"] = "Releases";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>Releases</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Release
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Application</label>
                    <select name="appId" class="form-select" asp-items="ViewBag.Apps">
                        <option value="">All Applications</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Environment</label>
                    <select name="environment" class="form-select" asp-items="ViewBag.Environments">
                        <option value="">All Environments</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select" asp-items="ViewBag.Statuses">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h5>No releases found</h5>
            <p>Try adjusting your filters or create a new release.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Application</th>
                        <th>Version</th>
                        <th>Environment</th>
                        <th>Status</th>
                        <th>Release Date</th>
                        <th>Released By</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Apps" asp-action="Details" asp-route-id="@item.AppId">
                                    <strong>@item.App?.Name</strong>
                                </a>
                            </td>
                            <td><span class="badge bg-dark">@item.Version</span></td>
                            <td><span class="badge bg-secondary">@item.Environment</span></td>
                            <td>
                                <status-badge value="@item.Status" />
                            </td>
                            <td>@item.ReleaseDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.ReleasedBy</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-2">
            <p class="text-muted">Showing @Model.Count() release(s)</p>
        </div>
    }
</div>
