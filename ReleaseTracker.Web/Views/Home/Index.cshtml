@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Total Applications</h6>
                            <h2 class="display-4 mt-2 mb-0">@ViewBag.TotalApps</h2>
                        </div>
                        <div>
                            <i class="bi bi-app-indicator" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a asp-controller="Apps" asp-action="Index" class="btn btn-light btn-sm">View All Apps</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Total Releases</h6>
                            <h2 class="display-4 mt-2 mb-0">@ViewBag.TotalReleases</h2>
                        </div>
                        <div>
                            <i class="bi bi-rocket-takeoff" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a asp-controller="Releases" asp-action="Index" class="btn btn-light btn-sm">View All Releases</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Releases This Week</h6>
                            <h2 class="display-4 mt-2 mb-0">@ViewBag.ReleasesThisWeek</h2>
                        </div>
                        <div>
                            <i class="bi bi-calendar-week" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <span class="text-white" style="opacity: 0.9;">Since @DateTime.Now.AddDays(-(int)DateTime.Now.DayOfWeek).ToString("MMM dd")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Recent Releases</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentReleases != null && ViewBag.RecentReleases.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Application</th>
                                        <th>Version</th>
                                        <th>Environment</th>
                                        <th>Status</th>
                                        <th>Release Date</th>
                                        <th>Released By</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var release in ViewBag.RecentReleases)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Apps" asp-action="Details" asp-route-id="@release.AppId">
                                                    <strong>@release.App?.Name</strong>
                                                </a>
                                            </td>
                                            <td><span class="badge bg-dark">@release.Version</span></td>
                                            <td><span class="badge bg-secondary">@release.Environment</span></td>
                                            <td>
                                                <status-badge value="@release.Status" />
                                            </td>
                                            <td>@release.ReleaseDate.ToString("MMM dd, yyyy")</td>
                                            <td>@release.ReleasedBy</td>
                                            <td>
                                                <a asp-controller="Releases" asp-action="Details" asp-route-id="@release.Id" class="btn btn-sm btn-outline-primary">
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox" style="font-size: 4rem;"></i>
                            <p class="mt-3">No releases yet. <a asp-controller="Releases" asp-action="Create">Create your first release</a></p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
